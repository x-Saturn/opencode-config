{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "opencode.settings": "alt+s",
    "command.palette.show": "alt+p",
    "prompt.skills": "alt+g",
    "session.background": "alt+z",
    "session.pin.toggle": "alt+l",
    "session.tab.next": "alt+pagedown,alt+down",
    "session.tab.previous": "alt+pageup,alt+up",
    "session.tab.reopen": "alt+r",
    "input.delete.to.line.end": "alt+k",
    "open.menu": "alt+o"
  },
  "session": {
    "scrollbar": true,
    "grouping": "none",
    "verbosity": "low"
  },
  "tabs": {
    "mode": "auto",
    "layout": "horizontal",
    "indicators": "status"
  },
  "diffs": {
    "view": "auto",
    "wrap": "word",
    "tree": true
  },
  "scroll": {
    "acceleration": false
  },
  "attention": {
    "notifications": false,
    "sound": true
  },
  "terminal": {
    "title": true
  },
  "theme": {
    "name": "opencode",
    "mode": "dark"
  }
}
